# Aplikacja
APP_ENV=development
APP_URL=http://localhost:8080
APP_PORT=8080

# Baza danych (PostgreSQL)
POSTGRES_PORT=5433
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
# Polaczenie z poziomu kontenera php (siec Docker, port wewnetrzny)
DB_HOST=db
DB_PORT=5432

# Poczta (SMTP). Lokalnie Mailpit: serwer w sieci Docker, podglad pod MAILPIT_PORT
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@motobid.local
SMTP_FROM_NAME=MotoBid
MAILPIT_PORT=8025

# pgAdmin
PGADMIN_CONTAINER_NAME=pg-admin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me
PGADMIN_PORT=5050
